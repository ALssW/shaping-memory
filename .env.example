# shaping-memory 环境变量模板
# ------------------------------------------------------------
# 用法：复制为 .env 后填入真实值（.env 已在 .gitignore 中，绝不要提交）
#   cp .env.example .env
#
# 【路径写法】三个目录变量都支持相对路径，相对的是「仓库根目录」，
# 因此 ./data 会解析成 <仓库根>/data，换机器/换盘符都不用改。
# ------------------------------------------------------------

# ---------- 数据库 ----------
# 数据库就装在本机：postgresql://shaping:***@127.0.0.1:5432/shaping_memory
# 数据库装在远程服务器：直接填远程地址即可，不需要 SSH 隧道
#   postgresql://shaping:***@<REMOTE_HOST>:15432/shaping_memory
# 远程库若只绑定了 127.0.0.1，可在服务器上用 nginx 的 stream 模块把端口转发出来
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/shaping_memory

# ---------- 目录（相对仓库根，也可写绝对路径）----------
# 原片来源目录（只读）：导入脚本从这里扫描照片
PHOTO_SOURCE_DIR=./photos
# 生成物目录（可写）：缩略图、模糊图、实况视频、EXIF 备份都落在这里
STORAGE_DIR=./data
# 第三方工具根目录：每个工具一个子目录。
# Windows 打包版解压到 exiftool/ 子目录下（需含 exiftool.exe 与 exiftool_files/）；
# Linux 用系统包安装时直接填可执行文件所在目录（如 /usr/bin）。
TOOLS_DIR=./tools

# ---------- 服务与认证 ----------
API_PORT=3000
API_HOST=127.0.0.1
# 会话签名密钥：至少 16 位随机字符（生产务必换掉）
JWT_SECRET=please-change-me-to-a-random-32-chars
# 初始管理员：仅 seed 时写入，之后由后台维护（至少 8 位）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me-8-chars-min

# ---------- 对外地址 ----------
# API 自己的对外基址（用于拼 og:image 等绝对地址）
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Web 前台地址（分享链接落地页）
WEB_BASE_URL=http://localhost:5173
# 允许跨域的前端来源，逗号分隔；留空 = 放行所有（仅限本地开发）
CORS_ORIGINS=

# ---------- 第三方服务 ----------
# 高德开放平台「Web 服务」key，仅后端使用（地图选点的地名搜索）
# 申请：https://console.amap.com/dev/key/app —— 类型务必选「Web 服务」，不是「Web 端(JS API)」
# 留空则地点搜索报「暂不可用」，其余功能不受影响
AMAP_KEY=

# ---------- 对象存储（可选）----------
# 默认 local：照片与生成物都留在本机 STORAGE_DIR，下面全部留空即可，项目照常完整运行。
# 想借对象存储省磁盘 / 做异地副本，才把 STORAGE_PROVIDER 改成 s3 并填写后面几项。
#
# 与配置模板的对应关系：
#   { provider: "s3",   bucket: "your-photos-bucket", region: "us-east-1",
#     prefix: "photos/", customDomain: "cdn.yourdomain.com" }
#   ↑ 依次对应下面的 STORAGE_PROVIDER / STORAGE_BUCKET / STORAGE_REGION /
#     STORAGE_PREFIX / STORAGE_CUSTOM_DOMAIN
STORAGE_PROVIDER=local

# 桶名与区域（s3 必填）。region 如 us-east-1、cn-hangzhou
STORAGE_BUCKET=
STORAGE_REGION=

# 服务地址（可选）：AWS 官方留空；阿里云 OSS、MinIO、Cloudflare R2 等**必须填**。
# 阿里云 OSS 例：oss-cn-hangzhou.aliyuncs.com（同区域内网可用 -internal 结尾，流量免费）
STORAGE_ENDPOINT=

# 寻址风格（s3 必填）：true = path-style（桶名写在路径里，自建 MinIO 用）；
# false = virtual-hosted（桶名进子域名，阿里云 OSS 等托管服务必须用 false，否则 403）
STORAGE_PATH_STYLE=true

# 所有对象的公共前缀，形如 photos/；留空表示直接放在桶根
STORAGE_PREFIX=

# 自定义域名（可选）：填了才会生成图片直链，需要该域名已绑定这个桶。
# **建议留空**——所有图片都由 API 转发，桶可保持完全私有，不必配任何额外权限。
STORAGE_CUSTOM_DOMAIN=

# 访问密钥（s3 必填）。**务必只写在 .env 里，不要提交到仓库**
# 建议使用子账号密钥，且权限只给这一个桶的读写
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- 前端构建期变量 ----------
# 注意：Vite / Expo 只读「各自 app 目录」下的 .env，不读本文件（仓库根）。
# 打包时用行内环境变量注入即可，例如：
#   VITE_API_BASE=https://api.example.com npm run build:web
#   EXPO_PUBLIC_API_BASE=https://api.example.com npx expo prebuild --platform android
# 移动端打包细节见 README「移动端打包」一节。